{
  "name": "cube-iii-backend",
  "version": "1.0.0",
  "description": "Cloudflare Backend for Cube III App (D1, Durable Objects, R2)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute cube_iii --remote --file=./schema.sql",
